{
  "manifest_version": 3,
  "name": "BC Crash Trend",
  "version": "3.0.0",
  "description": "Live bc.game Crash trend balls and stats from the provably-fair hash chain, shown inside the crash page.",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://bc.game/*",
    "https://*.bc.game/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "BC Crash Trend"
  },
  "content_scripts": [
    {
      "matches": [
        "https://bc.game/*",
        "https://*.bc.game/*"
      ],
      "js": [
        "inject.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://bc.game/*",
        "https://*.bc.game/*"
      ],
      "js": [
        "content.js",
        "overlay.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "panel.html",
        "panel.js",
        "style.css",
        "crash.js",
        "analysis.js",
        "trend.js",
        "chain.js",
        "latest.js",
        "worker.js"
      ],
      "matches": [
        "https://bc.game/*",
        "https://*.bc.game/*"
      ]
    }
  ]
}

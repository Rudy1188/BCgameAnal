{
  "manifest_version": 3,
  "name": "BC Watchdog",
  "version": "1.0.6",
  "description": "Trend balls, stats and streaks inside BC.Game Crash and Limbo, with up to 100,000 rounds of Crash history.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://bc.game/*",
    "https://*.bc.game/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "BC Watchdog",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://bc.game/*",
        "https://*.bc.game/*"
      ],
      "js": [
        "inject.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://bc.game/*",
        "https://*.bc.game/*"
      ],
      "js": [
        "content.js",
        "overlay.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "panel.html",
        "panel.js",
        "style.css",
        "crash.js",
        "analysis.js",
        "trend.js",
        "chain.js",
        "latest.js",
        "worker.js"
      ],
      "matches": [
        "https://bc.game/*",
        "https://*.bc.game/*"
      ]
    }
  ]
}

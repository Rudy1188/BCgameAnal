{
  "manifest_version": 3,
  "name": "BC Crash Trend",
  "version": "2.0.0",
  "description": "Live bc.game Crash trend balls, stats and biggest crashes from the provably-fair hash chain, in a small window that stays open.",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://bc.game/*",
    "https://*.bc.game/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "BC Crash Trend"
  },
  "content_scripts": [
    {
      "matches": [
        "https://bc.game/*",
        "https://*.bc.game/*"
      ],
      "js": [
        "inject.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://bc.game/*",
        "https://*.bc.game/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
